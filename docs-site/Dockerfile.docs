FROM nginx:alpine

# Create directories
RUN mkdir -p /usr/share/nginx/html/docs-content/tests

# Copy documentation HTML and nginx config from docs-site directory
COPY docs-site/index.html /usr/share/nginx/html/
COPY docs-site/nginx.conf /etc/nginx/conf.d/default.conf

# Copy all markdown documentation files from root
COPY *.md /usr/share/nginx/html/docs-content/

# Copy test documentation if exists
COPY tests/ /usr/share/nginx/html/docs-content/tests/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

